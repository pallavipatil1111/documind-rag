# Copy to .env and fill in. Never commit .env.

# Answers: anthropic (default) or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Embeddings (OpenAI text-embedding-3-small, 1536 dimensions)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vector database. The index is created on first start if it doesn't exist.
VECTOR_STORE=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=documind
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Retrieval (see eval/ for how these were chosen)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SCORE=0.25
CONTEXT_TOKEN_BUDGET=3000

# The frontend's address, for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Offline mode, no keys needed (word matching + quoted answers, for trying the app only):
# LLM_PROVIDER=extractive
# EMBEDDING_PROVIDER=hashing
# VECTOR_STORE=memory
